FROM golang:1.24 AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -o /out/backuper-web ./cmd/web

FROM gcr.io/distroless/base-debian12

WORKDIR /app
COPY --from=builder /out/backuper-web /app/backuper-web

EXPOSE 8080
ENV BACKUPER_SERVER_ADDR=server:9000

ENTRYPOINT ["/app/backuper-web"]
